# ==============================================================================
# DocuQuery Production & Development Environment Configuration (.env.example)
# ==============================================================================

# Application & Environment Settings
APP_NAME=DocuQuery API
APP_VERSION=1.0.0
ENVIRONMENT=production
PORT=8000
DEBUG=False

# CORS Origins (Comma-separated list of allowed URLs)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,https://your-frontend-domain.com

# Database Configuration (MongoDB Atlas in Production)
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
DATABASE_NAME=docuquery
MONGODB_SERVER_SELECTION_TIMEOUT_MS=5000
MONGODB_CONNECT_TIMEOUT_MS=5000

# Security & JWT Configuration
# IMPORTANT: Generate a strong 32+ character key:
# python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=your-secure-32-character-secret-key-change-this-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Cloudinary Document Storage
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Gemini AI / LLM Configuration
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash
GEMINI_TIMEOUT_SECONDS=30.0
GEMINI_MAX_RETRIES=2

# RAG & LLM Operational Settings
RATE_LIMIT_PER_MINUTE=20
CHAT_CACHE_TTL_SECONDS=600
SEMANTIC_CACHE_THRESHOLD=0.95
TOP_K_RESULTS=10
SIMILARITY_THRESHOLD=0.0
MAX_CONTEXT_CHUNKS=10
MAX_CONTEXT_CHARACTERS=12000
MAX_OUTPUT_TOKENS=512
TEMPERATURE=0.2
STREAMING_ENABLED=False
LLM_PROVIDER=gemini
